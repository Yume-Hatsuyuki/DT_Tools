<Project Sdk="Microsoft.NET.Sdk">
  <!-- 标签建议工具（开发期工具，不进游戏插件）。TFM 跟随仓库 global.json 的 SDK 7 → net7.0。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>suggest-tags</AssemblyName>
    <RootNamespace>SuggestTags</RootNamespace>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>
</Project>
