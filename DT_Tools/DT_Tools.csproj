<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DT_Tools</AssemblyName>
    <Description>Deadly Trick Plugin</Description>
    <Version>1.0.8.4</Version>
    <LangVersion>latest</LangVersion>
    <TargetName>$(AssemblyName)_$(Configuration)_$(Version)</TargetName>
    <!-- 相对 csproj 所在目录，上一级的 libs -->
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildThisFileDirectory)..\libs</GameManaged>
    <!-- WebUI 前端源码工程（Vue 3 + Vite + npm），构建产物直出 DT_Tools/WebUI -->
    <WebUISrc Condition="'$(WebUISrc)' == ''">$(MSBuildThisFileDirectory)..\webui-src</WebUISrc>
  </PropertyGroup>

  <!--
    前端增量构建（AGENTS.md §2）：源码晚于产物时经 npm 重建，产物直出 DT_Tools/WebUI，
    再随下方 None 项拷进输出目录。SkipWebUIBuild=true 整体跳过（CI 已显式构建前端、
    或多代理并行作业禁止构建时使用）。需要 Node/npm 环境。
  -->
  <Target Name="BuildWebUI"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipWebUIBuild)' != 'true'"
          Inputs="$(WebUISrc)\package.json;$(WebUISrc)\package-lock.json;$(WebUISrc)\vite.config.js;$(WebUISrc)\index.html;$(WebUISrc)\src\**"
          Outputs="$(MSBuildThisFileDirectory)WebUI\js\app.js">
    <Exec WorkingDirectory="$(WebUISrc)" Command="npm ci" Condition="!Exists('$(WebUISrc)\node_modules')" />
    <Exec WorkingDirectory="$(WebUISrc)" Command="npm run build" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="HarmonyX" Version="2.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DissonanceVoip">
      <HintPath>$(GameManaged)\DissonanceVoip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManaged)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>$(GameManaged)\Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(GameManaged)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(GameManaged)\com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spine-csharp">
      <HintPath>$(GameManaged)\spine-csharp.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="spine-unity">
      <HintPath>$(GameManaged)\spine-unity.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="WebUI/**" CopyToOutputDirectory="PreserveNewest" Link="WebUI/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
